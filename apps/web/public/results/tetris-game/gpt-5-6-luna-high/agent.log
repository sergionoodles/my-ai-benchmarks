+      border: 1px solid rgba(211, 243, 107, .14);
+      border-radius: 50%;
+    }
+
+    .stat-kicker {
+      margin: 0 0 8px;
+      color: var(--muted);
+      font-family: "Lucida Console", monospace;
+      font-size: 9px;
+      letter-spacing: .15em;
+      text-transform: uppercase;
+    }
+    .stat-value {
+      margin: 0;
