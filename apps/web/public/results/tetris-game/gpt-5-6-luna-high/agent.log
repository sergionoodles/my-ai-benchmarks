+      overflow: hidden;
+      background: linear-gradient(145deg, rgba(29, 34, 46, .9), rgba(14, 17, 24, .94));
+      border: 1px solid var(--line);
+      border-radius: var(--radius);
+      box-shadow: 0 12px 30px rgba(0,0,0,.16);
+    }
+    .stat-card::after, .next-card::after, .hold-card::after {
+      position: absolute;
+      right: -18px;
+      bottom: -29px;
+      width: 75px;
+      height: 75px;
+      content: "";
+      border: 1px solid rgba(211, 243, 107, .14);
+      border-radius: 50%;
+    }
+
+    .stat-kicker {
+      margin: 0 0 8px;
+      color: var(--muted);
+      font-family: "Lucida Console", monospace;
+      font-size: 9px;
+      letter-spacing: .15em;
+      text-transform: uppercase;
+    }
+    .stat-value {
+      margin: 0;
+      color: var(--paper);
+      font-family: "Lucida Console", monospace;
+      font-size: clamp(25px, 3vw, 34px);
+      font-weight: 700;
+      letter-spacing: -.07em;
+      line-height: 1;
+    }
+    .stat-value.acid { color: var(--acid); }
+    .stat-row {
+      display: grid;
+      grid-template-columns: 1fr 1fr;
+      gap: 9px;
+    }
+    .stat-row .stat-card { padding: 14px 14px 13px; }
+    .stat-row .stat-value { font-size: 22px; }
+
+    .mini-note {
+      margin: 11px 0 0;
+      color: var(--muted);
+      font-family: "Lucida Console", monospace;
+      font-size: 9px;
+      letter-spacing: .04em;
+    }
+    .meter { height: 3px; margin-top: 14px; overflow: hidden; background: #262c37; border-radius: 9px; }
+    .meter-fill { width: 64%; height: 100%; background: var(--acid); border-radius: inherit; box-shadow: 0 0 12px var(--acid); transition: width .3s ease; }
+
+    .board-wrap { position: relative; }
+    .board-head {
+      display: flex;
+      align-items: center;
+      justify-content: space-between;
+      width: 100%;
+      margin: 0 0 12px;
+      color: var(--muted);
+      font-family: "Lucida Console", monospace;
+      font-size: 9px;
+      letter-spacing: .16em;
+      text-transform: uppercase;
+    }
+    .board-head span:last-child { color: var(--acid); }
+    .board-frame {
+      position: relative;
+      padding: 10px;
+      background: #05070a;
+      border: 1px solid #4a5362;
+      border-radius: 8px;
+      box-shadow: 0 0 0 4px rgba(10, 13, 18, .7), 0 18px 55px rgba(0,0,0,.45), 0 0 45px rgba(211, 243, 107, .06);
+    }
+    #gameCanvas {
+      display: block;
+      width: calc(var(--cell) * 10);
+      height: calc(var(--cell) * 20);
+      max-width: 100%;
+      background: #0d1118;
+      border-radius: 3px;
+    }
+    .board-glow {
+      position: absolute;
+      inset: 30% -32px -30px;
+      z-index: -1;
+      pointer-events: none;
