+        paused = !paused; el("statusText").textContent = paused ? "○ paused" : "● live"; el("statusText").style.color = paused ? "var(--yellow)" : "var(--acid)";
+        setOverlay(paused, "system paused", "Paused", "Take a breath. Your stack is waiting.", "Resume run");
+        if (!paused) { lastTime = performance.now(); raf = requestAnimationFrame(loop); } else cancelAnimationFrame(raf);
+      }
+      function endGame() {
+        gameOver = true; paused = false; if (score > best) { best = score; localStorage.setItem("stackfall-best", best); }
+        el("statusText").textContent = "× game over"; el("statusText").style.color = "var(--red)";
+        setOverlay(true, "stack limit reached", "Game over", `Final score ${pad(score, 6)} · ${lines} lines cleared`, "Run it back"); updateUI(); draw();
+      }
+      function newGame() {
+        board = makeBoard(); queue = []; hold = null; canHold = true; score = 0; lines = 0; level = 1; dropCounter = 0; paused = false; gameOver = false; lastTime = performance.now();
