+    }
+
+    .brand-name {
+      margin: 0;
+      color: var(--paper);
+      font-size: 19px;
+      font-weight: 800;
+      letter-spacing: .2em;
+      line-height: 1;
+      text-transform: uppercase;
+    }
+
+    .brand-sub {
+      margin: 7px 0 0;
+      color: var(--muted);
+      font-family: "Lucida Console", monospace;
+      font-size: 9px;
+      letter-spacing: .14em;
+      text-transform: uppercase;
+    }
+
+    .top-actions { display: flex; gap: 9px; align-items: center; }
+    .icon-btn, .action-btn {
+      cursor: pointer;
+      color: var(--muted);
+      background: rgba(20, 24, 33, .7);
+      border: 1px solid var(--line);
+      border-radius: 6px;
+      transition: color .18s ease, border-color .18s ease, background .18s ease, transform .18s ease;
+    }
+    .icon-btn {
+      width: 40px;
+      height: 34px;
+      font-size: 17px;
+    }
+    .icon-btn:hover, .action-btn:hover, .icon-btn:focus-visible, .action-btn:focus-visible {
+      color: var(--acid);
+      background: var(--panel-hi);
+      border-color: var(--acid);
+      outline: none;
+      transform: translateY(-1px);
+    }
+
+    .game-layout {
+      display: grid;
+      grid-template-columns: minmax(160px, 1fr) auto minmax(180px, 1fr);
+      align-items: start;
+      gap: clamp(20px, 4vw, 64px);
+    }
+
+    .side { display: grid; gap: 18px; }
+    .side-left { padding-top: 66px; }
+    .side-right { padding-top: 0; }
+
+    .section-label {
