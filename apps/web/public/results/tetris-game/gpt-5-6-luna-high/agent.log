+++ b/tetris.html
@@ -0,0 +1,642 @@
+<!doctype html>
+<html lang="en">
+<head>
+  <meta charset="utf-8" />
+  <meta name="viewport" content="width=device-width, initial-scale=1" />
+  <title>Stack//Fall — Tetris</title>
+  <style>
+    :root {
+      --ink: #080a0f;
+      --ink-2: #10131a;
+      --panel: #141821;
+      --panel-hi: #1c212d;
+      --line: #303746;
+      --line-soft: rgba(183, 198, 199, .14);
+      --paper: #e7ece5;
+      --muted: #8b949e;
+      --acid: #d3f36b;
+      --orange: #ff754f;
+      --yellow: #f9c74f;
+      --cyan: #58d5d1;
+      --purple: #9f7aea;
+      --red: #f05262;
+      --cell: clamp(22px, 4.15vw, 37px);
+      --radius: 12px;
+    }
+
+    * { box-sizing: border-box; }
+    html { min-width: 320px; background: var(--ink); }
+    body {
+      margin: 0;
+      min-height: 100vh;
+      color: var(--paper);
+      background:
+        radial-gradient(circle at 50% -10%, rgba(68, 78, 101, .26), transparent 38rem),
+        linear-gradient(115deg, rgba(255, 117, 79, .045) 0 1px, transparent 1px 90px),
+        var(--ink);
+      font-family: "Trebuchet MS", "Gill Sans", sans-serif;
+      letter-spacing: .01em;
+    }
+
+    body::before {
+      position: fixed;
+      inset: 0;
+      z-index: 20;
+      pointer-events: none;
+      content: "";
+      opacity: .17;
+      background: repeating-linear-gradient(0deg, transparent 0 3px, rgba(255,255,255,.03) 3px 4px);
+      mix-blend-mode: screen;
+    }
+
+    button { font: inherit; }
+
+    .app-shell {
+      width: min(1220px, calc(100% - 42px));
+      margin: 0 auto;
+      padding: 34px 0 30px;
+    }
+
+    .topbar {
+      display: flex;
+      justify-content: space-between;
+      align-items: flex-start;
+      gap: 24px;
+      margin-bottom: 28px;
+    }
+
+    .brand {
+      display: flex;
+      align-items: center;
+      gap: 13px;
+    }
+
+    .brand-mark {
+      display: grid;
+      place-items: center;
+      width: 38px;
+      height: 38px;
+      color: var(--ink);
+      background: var(--acid);
+      border-radius: 50%;
