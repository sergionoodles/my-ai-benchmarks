    { "id": "has-toggle", "type": "contains", "weight": 1, "config": { "path": "todo.js", "pattern": "toggle" } },
    { "id": "has-remove", "type": "contains", "weight": 1, "config": { "path": "todo.js", "pattern": "remove" } }
  ]
}
