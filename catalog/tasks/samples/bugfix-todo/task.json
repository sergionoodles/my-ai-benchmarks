{
  "id": "bugfix-todo",
  "title": "Bugfix: todo list",
  "kind": "code",
  "description": "Fix two bugs in a tiny todo-list module so its tests pass.",
  "weights": { "checks": 0.6, "llmJudge": 0.3, "manual": 0.1 },
  "timeoutSec": 600,
  "screenshot": false,
