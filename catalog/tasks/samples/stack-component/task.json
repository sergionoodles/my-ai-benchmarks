{
  "id": "stack-component",
  "title": "Follow my stack",
  "kind": "mixed",
  "description": "Build a small Vite/React stats-card component following the repo's stack.",
  "weights": { "checks": 0.4, "llmJudge": 0.4, "manual": 0.2 },
  "timeoutSec": 600,
  "screenshot": true,
  "iframePath": "preview.html",
  "fixturePath": "fixture",
  "checks": [
    { "id": "component-exists", "type": "file-exists", "weight": 1, "config": { "path": "StatsCard.tsx" } },
    { "id": "uses-props", "type": "contains", "weight": 1, "config": { "path": "StatsCard.tsx", "pattern": "props" } },
    { "id": "preview-exists", "type": "file-exists", "weight": 1, "config": { "path": "preview.html" } }
  ]
}
